#cloud-config
# Source node: gets the shared PRIVATE key, the target list, the sender, and cron.
write_files:
  - path: /root/.ssh/id_ed25519
    permissions: '0600'
    encoding: b64
    content: ${private_key_b64}

  - path: /etc/simulation/config
    permissions: '0644'
    content: |
      FILENAME="${filename}"
      DURATION=${duration}
      MIN=${min}
      MAX=${max}
      DEST="${dest_dir}"

  - path: /etc/simulation/targets.txt
    permissions: '0644'
    encoding: b64
    content: ${targets_b64}

  - path: /opt/sim/drop.sh
    permissions: '0755'
    encoding: b64
    content: ${drop_sh_b64}

  - path: /opt/sim/setup_once.sh
    permissions: '0755'
    encoding: b64
    content: ${setup_once_b64}

  - path: /opt/sim/${filename}
    permissions: '0644'
    encoding: b64
    content: ${payload_b64}

runcmd:
  - install -d -m 700 /root/.ssh
  # Arm the sender FIRST. cron + scp already ship on the Debian 12 image, so a slow
  # or prompting apt can never stop the simulation from starting.
  - bash /opt/sim/setup_once.sh
  - ( crontab -l 2>/dev/null; echo '* * * * * /opt/sim/drop.sh' ) | crontab -
  - systemctl enable --now cron
  # Safety net only, and non-interactive so it can't hang on a dpkg prompt.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y cron openssh-client >/dev/null 2>&1 || true
