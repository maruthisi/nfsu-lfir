#cloud-config
# Mirror node: a normal Debian box with an 'analyst' login (the scp drop target).
# nginx is installed at boot and serves /var/data so drops are browsable.
users:
  - default
  - name: analyst
    groups: sudo
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: "${analyst_password}"
    ssh_authorized_keys:
      - ${sim_pubkey}
      - ${student_pubkey}

# Allow password login so students without an SSH key can still log in as analyst.
ssh_pwauth: true

package_update: true
packages:
  - nginx

write_files:
  - path: /etc/nginx/sites-available/lfir
    content: |
      server {
          listen 80 default_server;
          listen [::]:80 default_server;
          server_name _;
          root /var/data;
          location / {
              autoindex on;
              autoindex_exact_size off;
              autoindex_localtime on;
          }
      }

runcmd:
  - install -d -o analyst -g analyst -m 755 /var/data
  - rm -f /etc/nginx/sites-enabled/default
  - ln -sf /etc/nginx/sites-available/lfir /etc/nginx/sites-enabled/lfir
  - systemctl enable --now nginx
  - systemctl restart nginx
